{
  "name": "mercity-pulse",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c gray,blue \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "dev:demo": "DB_PATH=../data/demo.db npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
